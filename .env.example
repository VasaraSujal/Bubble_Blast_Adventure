# ==========================================
# BUBBLE BLAST ADVENTURE - ENVIRONMENT CONFIG
# ==========================================

# ------------------------------------------
# Frontend Variables (Client)
# Used in client/.env
# NOTE: Changing VITE_* variables requires app rebuild/restart.
# ------------------------------------------
VITE_GAME_NAME=BUBBLE BLAST ADVENTURE
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------
# Backend Variables (Server)
# Used in server/.env
# ------------------------------------------
PORT=5000
GAME_NAME=BUBBLE BLAST ADVENTURE
MONGODB_URI=mongodb://localhost:27017/bubble_blast
JWT_SECRET=your_jwt_secret_key_super_secure_2026
NODE_ENV=development
